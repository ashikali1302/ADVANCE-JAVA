import java.util.*;
public class Main
{
	public static void main(String[] args) 
	{
	    Scanner s=new Scanner(System.in);
		String[] names=new String[3];
		int[] marks=new int[3];
		for(int i=0;i<3;i++)
		{
		    System.out.println("Enter Name and Mark of the Student"+(i+1)+":");
		    marks[i]=s.nextInt();
		    s.nextLine();
		    names[i]=s.nextLine();
		    
		    
		}
		System.out.println("------------------------------------");
		int a=1;
		for(int i=0;i<3;i++)
		{
		  if(marks[i]>50)
		   {
		    System.out.println(a+"."+names[i]+" "+"secured:"+marks[i]);
		    a++;
		   }
		   
		}
		
	}
}
